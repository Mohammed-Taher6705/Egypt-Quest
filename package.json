{
  "name": "egypt-quest",
  "version": "4.3.0",
  "private": true,
  "description": "Egypt Quest — map adventure with a mini-game at every site. Web (PWA) + Android (Capacitor).",
  "scripts": {
    "start": "npx --yes http-server www -c-1 -p 8080",
    "android:init": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:bundle": "npx cap sync android && cd android && ./gradlew bundleRelease",
    "test": "node --test tests/*.test.js",
    "test:e2e": "python3 tests/e2e/progression_e2e.py"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
